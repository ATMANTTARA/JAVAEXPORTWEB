rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ptjavaessenceexport@gmail.com'];
    }

    match /products/{productId} {
      allow read: if request.auth != null
        && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    function buyerKeysOk() {
      return request.resource.data.keys().hasOnly(
        [
          'uid', 'name', 'email', 'photo', 'firstLogin', 'lastLogin', 'loginCount',
          'country', 'company', 'phone', 'profileAt', 'followUp', 'followUpAt'
        ]
      );
    }

    match /buyers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && buyerKeysOk()
        && !request.resource.data.keys().hasAny(['followUp', 'followUpAt']);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && buyerKeysOk()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['followUp', 'followUpAt']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followUp', 'followUpAt']);
      allow delete: if isAdmin();
    }

    match /logins/{loginId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'at']);
      allow read, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['product_view', 'whatsapp_click']
        && request.resource.data.keys().hasOnly(
          ['uid', 'email', 'type', 'productId', 'name', 'category', 'page', 'at']
        );
      allow read, delete: if isAdmin();
    }
  }
}
